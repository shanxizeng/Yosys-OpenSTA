# ============================================================
#  OpenSTA 全流程自动化配置文件
#  格式: KEY=VALUE，支持 # 注释
# ============================================================

# ---------- 工具路径（留空 = 使用 PATH 中的路径） ----------
YOSYS_BIN=
STA_BIN=

# ---------- 工艺库与约束 ----------
LIBERTY=/tools/nangate45/NangateOpenCellLibrary_typical.lib
SDC=constraints.sdc

# ---------- 设计与流程 ----------
SRC_DIR=verilogs
# TOP 留空 = 取 SRC_DIR 下按文件名排序的第一个 .sv/.v 文件
TOP=
# TOP_MODULE 留空 = 用 top 文件 stem 推断模块名
# （当文件内含多个 module、或模块名与文件名不一致时，需显式指定）
TOP_MODULE=
# 时钟周期 (ns)，自动替换 SDC 中 create_clock 的 period
CLK_PERIOD=10.0
# 包装方式: 1 = 寄存器包装（分析 reg2reg 关键路径）, 0 = 纯组合包装
REG_MODE=1
# 输出目录（所有生成物集中于此）
OUT_DIR=output

# ---------- STA 报告 ----------
# 报告最差路径条数
PATH_COUNT=10
